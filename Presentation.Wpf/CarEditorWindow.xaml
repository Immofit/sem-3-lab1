<local:BaseView x:Class="Presentation.Wpf.CarEditorWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:Presentation.Wpf"
                Title="{Binding Title}"
                Height="270"
                Width="340"
                ResizeMode="NoResize"
                WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="85" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Бренд:" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox Grid.Row="0" Grid.Column="1"
                 Text="{Binding Car.Brand, UpdateSourceTrigger=PropertyChanged}"
                 Height="26"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,8" />

        <Label Grid.Row="1" Grid.Column="0" Content="Модель:" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding Car.Model, UpdateSourceTrigger=PropertyChanged}"
                 Height="26"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,8" />

        <Label Grid.Row="2" Grid.Column="0" Content="Цвет:" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox Grid.Row="2" Grid.Column="1"
                 Text="{Binding Car.Color, UpdateSourceTrigger=PropertyChanged}"
                 Height="26"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,8" />

        <Label Grid.Row="3" Grid.Column="0" Content="Год:" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox Grid.Row="3" Grid.Column="1"
                 Text="{Binding YearText, UpdateSourceTrigger=PropertyChanged}"
                 Height="26"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,8" />

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Применить"
                    Command="{Binding ApplyCommand}"
                    IsDefault="True"
                    Width="105"
                    Height="32"
                    Margin="0,0,10,0" />
            <Button Content="Закрыть"
                    Command="{Binding CancelCommand}"
                    Width="105"
                    Height="32" />
        </StackPanel>
    </Grid>
</local:BaseView>
